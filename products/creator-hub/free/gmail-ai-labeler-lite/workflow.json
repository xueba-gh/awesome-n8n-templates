      "id": "628839a1-77ef-525b-a48e-c021c29260d9",
      "name": "New email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"config\": {\n    \"your_name\": \"Sam Taylor\",\n    \"your_role_and_business\": \"owner of Acme Plumbing, a local plumbing company\",\n    \"label_prefix\": \"AI/\",\n    \"log_sheet_url\": \"https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit\",\n    \"log_tab\": \"Inbox log\"\n  }\n}",
        "includeOtherFields": true,
        "options": {}
      },
      "id": "703fe1fd-2e50-513e-bbee-c80e4a7e8ff2",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Pulls out the parts of each email the AI needs, and skips mail it should never touch.\nconst out = [];\nfor (const { json: m } of $input.all()) {\n  const fromObj = m.from?.value?.[0] || {};\n  const fromRaw = typeof m.from === 'string' ? m.from : (m.from?.text || m.From || '');\n  const fromAddress = (fromObj.address || (fromRaw.match(/<([^>]+)>/) || [, fromRaw])[1] || '').trim().toLowerCase();\n  const fromName = fromObj.name || fromRaw.replace(/<[^>]+>/, '').replace(/\"/g, '').trim();\n  const subject = String(m.subject || m.Subject || '(no subject)').trim();\n  if (subject.startsWith('[Inbox Assistant]')) continue; // our own alerts\n  let body = String(m.text || m.snippet || '').replace(/\\r/g, '');\n  body = body.split(/\\n(?:On .{5,200}wrote:|-----Original Message-----|From: .+\\nSent: )/)[0]; // drop quoted history\n  out.push({ json: {\n    message_id: m.id,\n    thread_id: m.threadId,\n    from_address: fromAddress,\n    from_name: fromName,\n    subject,\n    body: body.trim().slice(0, 6000),\n    is_no_reply: /(no-?reply|do-?not-?reply|mailer-daemon|notifications?@|bounce)/i.test(fromAddress),\n  }});\n}\nreturn out;"
      },
      "id": "faf386b3-c4d2-58c2-9c90-9f35d71a5123",
      "name": "Prepare email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "d088fcce-2046-5811-8f79-8844615f7700",
      "name": "One email at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are the email assistant of {{ $('Settings').first().json.config.your_name }}, {{ $('Settings').first().json.config.your_role_and_business }}.\n\nRead this email and triage it.\n\nFrom: {{ $json.from_name }} <{{ $json.from_address }}>\nSubject: {{ $json.subject }}\nAutomated sender: {{ $json.is_no_reply ? 'yes' : 'no' }}\n\n{{ $json.body }}\n\nReturn:\n- category: exactly one of sales_lead (a potential new customer or a request for a quote/price), customer_support (an existing customer needs help), billing (invoices, payments, refunds), scheduling (meetings, appointments), personal, newsletter (marketing, newsletters, promotions), notification (automated alerts, receipts, system messages), spam, other.\n- urgency: high (needs action today, an angry customer, money or a deadline at stake), medium, or low.\n- needs_reply: true only if a real person is waiting for an answer from us. Always false for newsletter, notification, spam and automated senders.\n- summary: one sentence saying what the sender wants.\n",
        "hasOutputParser": true
      },
      "id": "f42267fd-4b99-51f6-8ed5-c699b7e5fba9",
      "name": "AI: triage email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        900,
        100
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "responsesApiEnabled": false,
        "options": {}
      },
      "id": "995cb375-8867-5781-8cd7-c766bc3b5660",
      "name": "OpenAI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        860,
        320
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"category\": \"sales_lead\",\n  \"urgency\": \"high\",\n  \"needs_reply\": true,\n  \"summary\": \"Wants a quote for a new water heater this week.\"\n}"
      },
      "id": "c4bd6f13-5eca-58bb-bcb5-e33c6504cdf1",
      "name": "Triage format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1000,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const email = $('One email at a time').first().json;\nconst ai = $json.output || {};\nconst allowed = ['sales_lead', 'customer_support', 'billing', 'scheduling', 'personal', 'newsletter', 'notification', 'spam', 'other'];\nconst category = allowed.includes(ai.category) ? ai.category : 'other';\nconst pretty = { sales_lead: 'Sales lead', customer_support: 'Customer support', billing: 'Billing', scheduling: 'Scheduling',\n  personal: 'Personal', newsletter: 'Newsletter', notification: 'Notification', spam: 'Spam', other: 'Other' }[category];\nconst needsReply = Boolean(ai.needs_reply) && !email.is_no_reply;\nreturn [{ json: {\n  ...email,\n  category,\n  label_name: $('Settings').first().json.config.label_prefix + pretty,\n  urgency: ['high', 'medium', 'low'].includes(ai.urgency) ? ai.urgency : 'medium',\n  needs_reply: needsReply,\n  summary: ai.summary || '',\n}}];"
      },
      "id": "3763459f-2526-5811-a0ff-0ab1c4f34ff2",
      "name": "Triage result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        100
      ]
    },
    {
      "parameters": {
        "resource": "label",
        "operation": "getAll",
        "returnAll": true
      },
      "id": "6ac1e283-ef76-59a2-96ee-1f7f8dc5e59f",
      "name": "Get Gmail labels",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1400,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const wanted = $('Triage result').first().json.label_name;\nconst match = $input.all().map(i => i.json).find(l => String(l.name).toLowerCase() === wanted.toLowerCase());\nreturn [{ json: { label_name: wanted, label_id: match ? match.id : '' } }];"
      },
