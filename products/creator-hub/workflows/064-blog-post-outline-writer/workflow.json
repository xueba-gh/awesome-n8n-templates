    {
      "parameters": {
        "jsCode": "const cfg = $('Settings').first().json.config;\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nreturn $input.all().filter((i) => has(i.json.topic) && !has(i.json[\"title_options\"])).slice(0, Number(cfg.rows_per_run));"
      },
      "id": "90a474bd-5345-5955-9816-2bdc102b1797",
      "name": "Find rows to fill in",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Create a blog post outline for {{ $('Settings').first().json.config.business_name }}. Topic: {{ $json.topic }}. Audience: {{ $json.audience }}. Give 3 title options and 5 to 7 headings with one-line key points. Avoid claims that need sources.",
        "hasOutputParser": true
      },
      "id": "972ca787-c90b-5937-aedc-c44b76a29938",
      "name": "AI: fill in the row",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
