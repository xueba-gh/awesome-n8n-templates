      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const key = (k) => String(k).toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');\nfunction flatten(o, into = {}) {\n  for (const [k, v] of Object.entries(o || {})) {\n    if (v && typeof v === 'object' && !Array.isArray(v)) flatten(v, into);\n    else if (!(key(k) in into)) into[key(k)] = v;\n  }\n  return into;\n}\nconst FIELDS = [\"customer\", \"email\", \"transcript\"];\nreturn $input.all().map((item) => {\n  const { config, headers, params, query, webhookUrl, executionMode, ...rest } = item.json;\n  const d = flatten(rest.body || rest);\n  const out = { received_at: new Date().toISOString() };\n  for (const f of FIELDS) out[f] = d[f] === undefined || d[f] === null ? '' : String(d[f]).trim();\n  return { json: out };\n});"
      },
      "id": "6b58fecc-8365-570f-b186-43923e18bdd0",
      "name": "Clean up details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Summarise this support chat for {{ $('Settings').first().json.config.business_name }}: a two-sentence summary, the outcome (resolved, unresolved, needs follow-up) and one follow-up task if any.\n\nDetails received:\n- Customer: {{ $json.customer || 'not given' }}\n- Email: {{ $json.email || 'not given' }}\n- Transcript: {{ $json.transcript || 'not given' }}",
        "hasOutputParser": true
      },
      "id": "37c424e8-641f-5d31-9460-02b0a1f92d1c",
      "name": "AI: summarise the chat",
