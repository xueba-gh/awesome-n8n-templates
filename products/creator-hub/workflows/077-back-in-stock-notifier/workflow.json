        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const daysSince = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (Date.now() - t) / 86400000; };\nconst daysUntil = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (t - Date.now()) / 86400000; };\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nconst cfg = $('Settings').first().json.config;\nreturn $input.all().filter((item) => {\n  const r = item.json;\n  return (String(r.in_stock).toLowerCase() === 'yes' && !has(r.notified));\n}).slice(0, 50);"
      },
      "id": "8ac7a3f3-0f27-54a0-9ef9-0746c81f9a1a",
      "name": "Find rows to act on",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.product }} is back in stock",
        "emailType": "text",
        "message": "=Good news! {{ $json.product }} is back in stock. Get it before it sells out again.\n\n{{ $('Settings').first().json.config.business_name }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "ebf87e36-f6bb-5acb-a5b6-783e9f2d84c9",
      "name": "Send email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
