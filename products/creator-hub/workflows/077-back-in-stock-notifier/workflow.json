    {
      "parameters": {
        "jsCode": "const stamp = new Date().toISOString().slice(0, 10);\nreturn $('Find rows to act on').all().map((item) => ({ json: { row_number: item.json.row_number, \"notified\": stamp } }));"
      },
      "id": "d06cdc2d-bd2d-5854-bdc2-ec0ebc26e5a1",
      "name": "Mark rows as done",
