      "typeVersion": 4.7,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Settings').first().json.config;\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nreturn $input.all().filter((i) => has(i.json.company) && !has(i.json[\"industry\"])).slice(0, Number(cfg.rows_per_run));"
      },
      "id": "a890e57f-a02d-5f9f-92f1-33b1094d43db",
      "name": "Find rows to fill in",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Company: {{ $json.company }}\nWebsite: {{ $json.website }}\nGive a likely industry and a one-sentence outreach angle for a small service business. If unsure, say 'unknown'. Do not invent facts.",
        "hasOutputParser": true
      },
      "id": "f25a1409-c10d-5f53-a071-2fcd8eef08c9",
      "name": "AI: fill in the row",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "responsesApiEnabled": false,
        "options": {}
      },
      "id": "6ea374ae-ac84-5ec8-a19c-2de384d0c9e9",
      "name": "AI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        960,
        220
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"industry\": \"Dental clinic\",\n  \"outreach_angle\": \"Offer faster reply to new patient enquiries.\"\n}"
      },
      "id": "2739d328-8851-58d5-ab96-d52e9a8b5117",
      "name": "AI output format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1160,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => ({ json: { row_number: $('Find rows to fill in').all()[i].json.row_number, ...item.json.output } }));"
      },
      "id": "3a1ab84c-e179-5235-bfae-933e974bd127",
