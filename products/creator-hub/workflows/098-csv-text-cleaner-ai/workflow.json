        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Settings').first().json.config.sheet_url }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Settings').first().json.config.sheet_tab }}"
        },
        "options": {}
      },
      "id": "2e97ca7f-4f9d-50ee-8cf5-e69b01544f65",
      "name": "Read rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Settings').first().json.config;\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nreturn $input.all().filter((i) => has(i.json.raw_name) && !has(i.json[\"clean_name\"])).slice(0, Number(cfg.rows_per_run));"
      },
      "id": "5eea471c-ace7-5670-be4e-3f0cbe9cab35",
      "name": "Find rows to fill in",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Clean this contact. Name: {{ $json.raw_name }}. Phone: {{ $json.raw_phone }}. Company: {{ $json.raw_company }}. Return a properly capitalised name, the phone in international format (guess country only if obvious, else leave as is), and a tidy company name. Do not invent data.",
        "hasOutputParser": true
      },
      "id": "df0380b2-cde9-5412-b80f-bdaf702d666e",
      "name": "AI: fill in the row",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "responsesApiEnabled": false,
        "options": {}
      },
      "id": "4fdced6c-c3a5-54f9-b632-75b984fd75a0",
      "name": "AI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        960,
        220
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"clean_name\": \"Jane Smith\",\n  \"clean_phone\": \"+15551234567\",\n  \"clean_company\": \"Acme Ltd\"\n}"
      },
      "id": "4481d9b8-8702-5ca6-a442-081ea94af93d",
      "name": "AI output format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1160,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => ({ json: { row_number: $('Find rows to fill in').all()[i].json.row_number, ...item.json.output } }));"
      },
      "id": "ab099ba2-4447-5bea-aa7e-30fd17e9ed17",
      "name": "Match results to rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Settings').first().json.config.sheet_url }}"
        },
