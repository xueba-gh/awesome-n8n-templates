{
  "name": "Customer satisfaction survey sender after a job is done",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 11
            }
          ]
        }
      },
      "id": "925b3beb-6765-50be-ba56-8d830dccf823",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"config\": {\n    \"sheet_url\": \"https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit\",\n    \"sheet_tab\": \"Jobs\",\n    \"owner_email\": \"you@example.com\",\n    \"business_name\": \"Your Business\",\n    \"sender_name\": \"Your Name\",\n    \"survey_link\": \"https://forms.gle/your-survey\"\n  }\n}",
        "includeOtherFields": true,
        "options": {}
      },
      "id": "82aca163-a7e4-5ac3-b31a-1927676a2007",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Settings').first().json.config.sheet_url }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Settings').first().json.config.sheet_tab }}"
        },
        "options": {}
      },
      "id": "995296a6-a603-594f-b1eb-c1732190a202",
      "name": "Read rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const daysSince = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (Date.now() - t) / 86400000; };\nconst daysUntil = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (t - Date.now()) / 86400000; };\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nconst cfg = $('Settings').first().json.config;\nreturn $input.all().filter((item) => {\n  const r = item.json;\n  return (!has(r.survey_sent) && daysSince(r.completed_date) !== null && daysSince(r.completed_date) >= 2);\n}).slice(0, 50);"
      },
      "id": "bb64bcbb-f60b-51dd-a74c-858ba2d2d328",
      "name": "Find rows to act on",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=How did we do with {{ $json.job }}?",
        "emailType": "text",
        "message": "=Hi {{ $json.customer }},\n\nThanks for choosing {{ $('Settings').first().json.config.business_name }}. Could you spare a minute to tell us how it went?\n\n{{ $('Settings').first().json.config.survey_link }}\n\n{{ $('Settings').first().json.config.sender_name }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "6fb7b16f-7376-530c-8f0f-46b9eb060f18",
      "name": "Send email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const stamp = new Date().toISOString().slice(0, 10);\nreturn $('Find rows to act on').all().map((item) => ({ json: { row_number: item.json.row_number, \"survey_sent\": stamp } }));"
      },
      "id": "90af6553-5c98-558c-b1a4-af4a7f62c068",
      "name": "Mark rows as done",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "operation": "update",
