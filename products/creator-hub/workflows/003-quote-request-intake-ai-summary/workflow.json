    {
      "parameters": {
        "jsCode": "const key = (k) => String(k).toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');\nfunction flatten(o, into = {}) {\n  for (const [k, v] of Object.entries(o || {})) {\n    if (v && typeof v === 'object' && !Array.isArray(v)) flatten(v, into);\n    else if (!(key(k) in into)) into[key(k)] = v;\n  }\n  return into;\n}\nconst FIELDS = [\"name\", \"email\", \"phone\", \"service\", \"details\"];\nreturn $input.all().map((item) => {\n  const { config, headers, params, query, webhookUrl, executionMode, ...rest } = item.json;\n  const d = flatten(rest.body || rest);\n  const out = { received_at: new Date().toISOString() };\n  for (const f of FIELDS) out[f] = d[f] === undefined || d[f] === null ? '' : String(d[f]).trim();\n  return { json: out };\n});"
      },
      "id": "289c11c0-bdf8-53d5-8e36-5195cc5b16ab",
      "name": "Clean up details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You help {{ $('Settings').first().json.config.business_name }} handle quote requests. Write a two-sentence job summary, list the details still missing that you would need to quote (or 'none'), and rate urgency as low, normal or high.\n\nDetails received:\n- Name: {{ $json.name || 'not given' }}\n- Email: {{ $json.email || 'not given' }}\n- Phone: {{ $json.phone || 'not given' }}\n- Service: {{ $json.service || 'not given' }}\n- Details: {{ $json.details || 'not given' }}",
        "hasOutputParser": true
      },
      "id": "441a4c58-f87b-5d8e-ad5d-3c343f31f7f9",
      "name": "AI: summarise the request",
