      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"config\": {\n    \"sheet_url\": \"https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit\",\n    \"sheet_tab\": \"Support log\",\n    \"owner_email\": \"you@example.com\",\n    \"business_name\": \"Your Business\",\n    \"sender_name\": \"Your Name\"\n  }\n}",
        "includeOtherFields": true,
        "options": {}
      },
      "id": "517a4d67-4105-5d96-b15d-8fa755883b4e",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Settings').first().json.config.sheet_url }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Settings').first().json.config.sheet_tab }}"
        },
        "options": {}
      },
      "id": "cef1ff4a-3e52-5988-b6a8-16e7f6964272",
      "name": "Read rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Settings').first().json.config;\nconst rows = $input.all().map((i) => i.json).filter((r) => (true)).slice(0, 150);\nconst text = rows.map((r) => Object.entries(r).filter(([k]) => k !== 'row_number').map(([k, v]) => k + ': ' + v).join(' | ')).join('\\n');\nreturn [{ json: { count: rows.length, rows_text: text || 'No rows.' } }];"
      },
      "id": "c334a901-e282-5167-9451-6bcf7386a0cd",
      "name": "Prepare the rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You analyse a week of support requests for a small business. List the top 3 recurring themes with counts, what to add to the FAQ or fix in the product, and any urgent pattern.\n\nNumber of rows: {{ $json.count }}\nRows:\n{{ $json.rows_text }}",
        "hasOutputParser": true
      },
      "id": "9a5a5538-ab49-520d-b0b2-72a99e2e1607",
      "name": "AI: write the summary",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "responsesApiEnabled": false,
        "options": {}
      },
      "id": "aba33dd4-fc07-5670-b8f6-de8bd5efe929",
      "name": "AI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        960,
        220
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"headline\": \"Short subject line\",\n  \"summary\": \"Two or three sentences.\",\n  \"actions\": \"- First action\\n- Second action\"\n}"
      },
      "id": "664268e4-930c-56ad-9c82-84d925c94470",
      "name": "AI output format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1160,
        220
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Settings').first().json.config.owner_email }}",
        "subject": "={{ $json.output.headline }}",
        "emailType": "text",
        "message": "={{ $json.output.summary }}\n\nWhat to do next:\n{{ $json.output.actions }}\n\n(Based on {{ $('Prepare the rows').first().json.count }} rows from your sheet.)",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "26dd9aee-da70-59e5-b7a9-9ad75e33486e",
      "name": "Email the summary",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
