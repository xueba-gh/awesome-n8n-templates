{
  "name": "Weekly support themes report (what customers keep asking)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 16
            }
          ]
        }
      },
      "id": "bbd62ba8-64a9-59cf-8c37-a25c0542e3fa",
