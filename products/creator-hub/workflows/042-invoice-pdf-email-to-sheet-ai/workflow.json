        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((i) => {\n  const j = i.json;\n  const from = (j.from && j.from.value && j.from.value[0]) ? j.from.value[0] : {};\n  return { json: {\n    message_id: j.id, thread_id: j.threadId,\n    from_address: from.address || String(j.from || ''), from_name: from.name || '',\n    subject: j.subject || '', body: String(j.text || j.snippet || '').slice(0, 4000),\n    received_at: new Date().toISOString(),\n  } };\n});"
      },
      "id": "c5b91a52-d280-50fb-a26c-0d320ecb83d0",
      "name": "Read the email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Extract invoice details from this email text. is_invoice, vendor, invoice_number, amount (number), currency, due_date (YYYY-MM-DD or empty). Leave unknowns empty, never guess.\n\nEmail:\nFrom: {{ $json.from_name }} <{{ $json.from_address }}>\nSubject: {{ $json.subject }}\n\n{{ $json.body }}",
        "hasOutputParser": true
      },
      "id": "43006fda-30b6-5770-af93-9e6e8d13b7f6",
