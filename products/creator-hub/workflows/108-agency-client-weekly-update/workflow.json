    {
      "parameters": {
        "jsCode": "const daysSince = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (Date.now() - t) / 86400000; };\nconst daysUntil = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (t - Date.now()) / 86400000; };\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nconst cfg = $('Settings').first().json.config;\nreturn $input.all().filter((item) => {\n  const r = item.json;\n  return (daysSince(r.last_update_sent) === null || daysSince(r.last_update_sent) >= Number(r.frequency_days || 7));\n}).slice(0, 50);"
      },
      "id": "e14a4787-b7f6-57ab-b568-78da7ac5b4e4",
