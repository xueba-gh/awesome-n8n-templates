      "parameters": {
        "jsCode": "const stamp = new Date().toISOString().slice(0, 10);\nreturn $('Find rows to act on').all().map((item) => ({ json: { row_number: item.json.row_number, \"last_update_sent\": stamp } }));"
      },
      "id": "8c3cab21-be75-5e75-be27-5b8a851faee1",
