      "typeVersion": 2.3,
      "position": [
        0,
        0
      ],
      "webhookId": "b7d2ca1e-a8f3-5606-83cb-6c41cd195ba3"
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"config\": {\n    \"sheet_url\": \"https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit\",\n    \"sheet_tab\": \"Imported\",\n    \"required_columns\": [\n      \"email\"\n    ]\n  }\n}",
        "includeOtherFields": true,
        "options": {}
      },
      "id": "54c75f83-2467-5892-9e67-56e6c7e37a5f",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "binaryPropertyName": "CSV_file",
        "options": {}
      },
      "id": "7bc9fe68-49ed-5b62-ba20-820116503a40",
      "name": "Read the CSV",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Settings').first().json.config;\nconst key = (k) => String(k).trim().toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');\nconst title = (s) => s.replace(/\\s+/g, ' ').trim().toLowerCase().replace(/(^|[\\s'-])\\p{L}/gu, (m) => m.toUpperCase());\nconst seen = new Set();\nconst out = [];\nfor (const { json: raw } of $input.all()) {\n  const r = {};\n  for (const [k, v] of Object.entries(raw)) r[key(k)] = String(v ?? '').replace(/\\s+/g, ' ').trim();\n  if (r.email !== undefined) { r.email = r.email.toLowerCase(); if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(r.email)) r.email = ''; }\n  for (const c of ['name', 'first_name', 'last_name', 'city']) if (r[c]) r[c] = title(r[c]);\n  if (r.phone !== undefined) r.phone = r.phone.replace(/[^\\d+]/g, '');\n  if ((cfg.required_columns || []).some((c) => !r[c])) continue;\n  const id = JSON.stringify(r);\n  if (seen.has(id)) continue;\n  seen.add(id);\n  out.push({ json: r });\n}\nreturn out;"
      },
      "id": "4b3388cd-75c8-5d15-9627-92e3450e0c83",
      "name": "Clean the rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
