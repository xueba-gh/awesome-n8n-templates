        "promptType": "define",
        "text": "=Summarise this meeting. Give a three-sentence summary, the decisions made, and action items with an owner and due date if mentioned. Do not invent owners.\n\nDetails received:\n- Meeting title: {{ $json.meeting_title || 'not given' }}\n- Attendees: {{ $json.attendees || 'not given' }}\n- Notes: {{ $json.notes || 'not given' }}",
        "hasOutputParser": true
      },
