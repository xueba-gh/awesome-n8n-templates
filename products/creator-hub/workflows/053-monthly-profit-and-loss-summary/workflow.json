{
  "name": "Monthly profit and loss summary in plain English",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "b702f35b-a3e6-552d-a0ec-301b0aee956f",
      "name": "Schedule",
