      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((i) => {\n  const j = i.json;\n  const from = (j.from && j.from.value && j.from.value[0]) ? j.from.value[0] : {};\n  return { json: {\n    message_id: j.id, thread_id: j.threadId,\n    from_address: from.address || String(j.from || ''), from_name: from.name || '',\n    subject: j.subject || '', body: String(j.text || j.snippet || '').slice(0, 4000),\n    received_at: new Date().toISOString(),\n  } };\n});"
      },
      "id": "9e1e5f6c-6385-5a40-a1dd-b64f5e0a8091",
      "name": "Read the email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=This is a Google Alerts email for {{ $('Settings').first().json.config.business_name }}. Summarise the mention in one sentence, give sentiment (positive, neutral, negative) and say whether it deserves a public reply.\n\nEmail:\nFrom: {{ $json.from_name }} <{{ $json.from_address }}>\nSubject: {{ $json.subject }}\n\n{{ $json.body }}",
        "hasOutputParser": true
      },
      "id": "e3c0c917-3c31-5776-98d2-3a6db196e74b",
