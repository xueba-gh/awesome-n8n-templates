      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You triage maintenance requests for a property manager. Rate urgency (emergency only for flooding, gas smell, no heating in winter, fire or safety risk; otherwise normal or low) and name the trade needed (plumber, electrician, general, other). One-sentence summary.\n\nDetails received:\n- Name: {{ $json.name || 'not given' }}\n- Email: {{ $json.email || 'not given' }}\n- Unit: {{ $json.unit || 'not given' }}\n- Issue: {{ $json.issue || 'not given' }}",
        "hasOutputParser": true
      },
      "id": "c2f6cf6e-6763-5dfc-a870-eab86d1bdf6f",
      "name": "AI: triage the request",
