            "row_number"
          ],
          "schema": []
        },
        "options": {
          "cellFormat": "RAW",
          "handlingExtraData": "ignoreIt"
        }
      },
      "id": "393b5b58-80ae-5a6b-894b-aacbbf76525d",
      "name": "Update rows",
