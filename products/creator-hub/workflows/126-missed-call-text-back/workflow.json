      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<Response><Dial timeout=\"{{ $('Settings').first().json.config.ring_seconds }}\" action=\"{{ $('Settings').first().json.config.dial_result_url }}\" method=\"POST\">{{ $('Settings').first().json.config.owner_phone }}</Dial></Response>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/xml"
              }
            ]
          }
        }
      },
      "id": "088fa944-14e1-5337-95b6-8ceaafc25403",
      "name": "Ring your phone",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "call-finished",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "f8095184-c861-599a-8169-8605a9d33284",
      "name": "Call finished",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "webhookId": "7cdb2709-6aaa-50c8-be8f-99fa0ad725a0"
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst status = String(b.DialCallStatus || '').toLowerCase();\nconst missed = ['no-answer', 'busy', 'failed', 'canceled'].includes(status);\nreturn [{ json: { caller: String(b.From || '').trim(), status, missed, called_at: new Date().toISOString() } }];"
      },
      "id": "a4b1202d-5a20-56f2-ae56-cd447ae9c924",
      "name": "Was it missed?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.missed ? '<Response><Say>Sorry we missed you. We will text you right away.</Say></Response>' : '<Response></Response>' }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/xml"
              }
            ]
          }
        }
      },
      "id": "7413a8fb-bef8-5c32-ab82-e1c5b773899d",
      "name": "Answer Twilio",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "acb0391b-3c3a-5c7f-bcd0-5ba9a6369ce8",
              "leftValue": "={{ $('Was it missed?').item.json.missed && $('Was it missed?').item.json.caller !== '' }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
