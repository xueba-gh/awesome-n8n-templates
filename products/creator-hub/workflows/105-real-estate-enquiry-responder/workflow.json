    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You help a real estate agent at {{ $('Settings').first().json.config.business_name }}. Summarise this property enquiry: what they want, budget if given, timeline, and whether they ask for a viewing. Never state prices or availability.\n\nDetails received:\n- Name: {{ $json.name || 'not given' }}\n- Email: {{ $json.email || 'not given' }}\n- Phone: {{ $json.phone || 'not given' }}\n- Property: {{ $json.property || 'not given' }}\n- Message: {{ $json.message || 'not given' }}",
        "hasOutputParser": true
      },
      "id": "6371a69d-6594-5153-81a7-74e4d238a92b",
      "name": "AI: summarise the enquiry",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
