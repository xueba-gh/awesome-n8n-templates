        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $('New email').all().map((i) => ({ json: { from: (i.json.from && i.json.from.text) || '', subject: i.json.subject || '',\n  body: String(i.json.text || i.json.snippet || '').slice(0, 4000) } }));"
      },
      "id": "92e2a7aa-cefa-5736-bc19-3820132d3146",
      "name": "Read the email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Read this email and decide whether it asks the reader to do something.\n\nFrom: {{ $json.from }}\nSubject: {{ $json.subject }}\n\n{{ $json.body }}\n\nReturn is_task (true/false), task (a short imperative title, empty if no task), due (a date if one is stated, else empty) and details (one or two sentences of context).",
        "hasOutputParser": true
      },
      "id": "7775c1cb-7b9e-56c2-ba8d-76f26e1b343d",
      "name": "AI: is there a task?",
