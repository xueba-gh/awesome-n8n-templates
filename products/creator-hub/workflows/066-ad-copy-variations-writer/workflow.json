      "typeVersion": 4.7,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Settings').first().json.config;\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nreturn $input.all().filter((i) => has(i.json.offer) && !has(i.json[\"variation_1\"])).slice(0, Number(cfg.rows_per_run));"
      },
      "id": "55251b4f-48b6-5876-a0a0-033e507882f9",
      "name": "Find rows to fill in",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write 3 ad variations for {{ $json.platform }}. Offer: {{ $json.offer }}. Audience: {{ $json.audience }}. Each with a headline under 30 characters and a description under 90 characters. Honest claims only.",
        "hasOutputParser": true
      },
      "id": "af774ff7-7e7b-5b3c-861a-7d715756377f",
      "name": "AI: fill in the row",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "responsesApiEnabled": false,
        "options": {}
      },
      "id": "1c3e18bf-c50e-5741-a000-f6d94e6c7c70",
      "name": "AI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        960,
        220
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"variation_1\": \"Headline | Description\",\n  \"variation_2\": \"Headline | Description\",\n  \"variation_3\": \"Headline | Description\"\n}"
      },
      "id": "66c3139c-06fc-557e-9d8e-c42007bd2a6c",
      "name": "AI output format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1160,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => ({ json: { row_number: $('Find rows to fill in').all()[i].json.row_number, ...item.json.output } }));"
      },
      "id": "144db0cd-161b-5dd0-a4c8-aa6f3dd09bb5",
      "name": "Match results to rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
