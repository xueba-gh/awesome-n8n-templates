      "id": "926ca674-36d5-5c74-8a13-c1dcd2229afe",
      "name": "Read rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const daysSince = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (Date.now() - t) / 86400000; };\nconst daysUntil = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (t - Date.now()) / 86400000; };\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nconst cfg = $('Settings').first().json.config;\nreturn $input.all().filter((item) => {\n  const r = item.json;\n  return (!has(r.replied) && daysSince(r.sent_date) !== null && daysSince(r.sent_date) >= 3 && (!has(r.last_reminder) || daysSince(r.last_reminder) >= 3));\n}).slice(0, 50);"
      },
      "id": "563c05c4-e36e-53f2-a6a5-484d23f405b3",
      "name": "Find rows to act on",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Settings').first().json.config.owner_email }}",
        "subject": "=No reply yet from {{ $json.to }}",
        "emailType": "text",
        "message": "=You emailed {{ $json.to }} about '{{ $json.subject }}' on {{ $json.sent_date }} and have no reply logged. Time to chase?",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "43af6018-1726-586f-8109-1136b2c09b95",
      "name": "Send email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const stamp = new Date().toISOString().slice(0, 10);\nreturn $('Find rows to act on').all().map((item) => ({ json: { row_number: item.json.row_number, \"last_reminder\": stamp } }));"
      },
      "id": "52efe399-9279-58da-a414-6334f52f6608",
      "name": "Mark rows as done",
