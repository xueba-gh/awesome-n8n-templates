          {
            "node": "Problem found?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Problem found?": {
      "main": [
        [
          {
            "node": "Email me the alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
