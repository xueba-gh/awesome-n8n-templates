      "parameters": {
        "jsCode": "const daysSince = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (Date.now() - t) / 86400000; };\nconst daysUntil = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (t - Date.now()) / 86400000; };\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nconst cfg = $('Settings').first().json.config;\nreturn $input.all().filter((item) => {\n  const r = item.json;\n  return (!has(r.reminder_sent) && has(r.phone) && daysUntil(r.appointment_at) !== null && daysUntil(r.appointment_at) > 0 && daysUntil(r.appointment_at) <= 1);\n}).slice(0, 50);"
      },
      "id": "2d399e7e-c1e6-540f-a248-e3ed68a370dc",
