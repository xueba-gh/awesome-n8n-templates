      "name": "New email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"config\": {\n    \"sheet_url\": \"https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit\",\n    \"sheet_tab\": \"Meeting requests\",\n    \"owner_email\": \"you@example.com\",\n    \"business_name\": \"Your Business\",\n    \"sender_name\": \"Your Name\",\n    \"booking_link\": \"https://cal.com/your-name\"\n  }\n}",
        "includeOtherFields": true,
        "options": {}
      },
      "id": "a4b6e942-09cb-5027-9d32-569a2dd974b2",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((i) => {\n  const j = i.json;\n  const from = (j.from && j.from.value && j.from.value[0]) ? j.from.value[0] : {};\n  return { json: {\n    message_id: j.id, thread_id: j.threadId,\n    from_address: from.address || String(j.from || ''), from_name: from.name || '',\n    subject: j.subject || '', body: String(j.text || j.snippet || '').slice(0, 4000),\n    received_at: new Date().toISOString(),\n  } };\n});"
      },
      "id": "95e9c580-d301-5ce2-94b2-0c740b50a654",
      "name": "Read the email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Decide if this email asks for a meeting or call. Give is_meeting_request, the times they proposed (or 'none'), and a short reply draft that asks for your availability link: {{ $('Settings').first().json.config.booking_link }}. Do not confirm any time.\n\nEmail:\nFrom: {{ $json.from_name }} <{{ $json.from_address }}>\nSubject: {{ $json.subject }}\n\n{{ $json.body }}",
        "hasOutputParser": true
      },
      "id": "45bf93dd-206c-5d07-a833-3c0a28b4857c",
      "name": "AI: read the email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "responsesApiEnabled": false,
        "options": {}
      },
      "id": "dceafdec-8de2-5256-88d6-c2d0d2906d9f",
      "name": "AI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        720,
        260
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"is_meeting_request\": true,\n  \"proposed_times\": \"Thursday afternoon\",\n  \"needs_reply\": true,\n  \"summary\": \"Wants a 30-minute intro call.\",\n  \"reply_draft\": \"Hi ...\"\n}"
      },
      "id": "f4997515-9b9f-58a7-b52a-d516fe0f9d4f",
      "name": "AI output format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        920,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => ({ json: { ...$('Read the email').all()[i].json, ...item.json.output } }));"
      },
      "id": "b880b9de-f809-5d51-8867-9856afb89f70",
      "name": "Combine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
