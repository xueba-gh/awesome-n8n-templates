        "options": {}
      },
      "id": "b1115c11-6c6c-58af-9dd2-98efdcfbca0c",
      "name": "AI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        720,
