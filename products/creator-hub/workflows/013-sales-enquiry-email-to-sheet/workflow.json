    {
      "parameters": {
        "promptType": "define",
        "text": "=You look at emails for {{ $('Settings').first().json.config.business_name }}. Decide if this is a sales enquiry (someone who may pay us). Give is_enquiry (true/false), score 1-10 for buying intent, a one-sentence summary and, if is_enquiry, a short reply draft.\n\nEmail:\nFrom: {{ $json.from_name }} <{{ $json.from_address }}>\nSubject: {{ $json.subject }}\n\n{{ $json.body }}",
        "hasOutputParser": true
      },
      "id": "322f3996-9a51-5668-929a-abc5467e6866",
