      "id": "4ac5ad40-a4bf-5c84-b67c-5dc9db7c4aff",
      "name": "Read rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const daysSince = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (Date.now() - t) / 86400000; };\nconst daysUntil = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (t - Date.now()) / 86400000; };\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nconst cfg = $('Settings').first().json.config;\nreturn $input.all().filter((item) => {\n  const r = item.json;\n  return (String(r.status).toLowerCase() === 'done' && !has(r.review_sms_sent) && has(r.phone) && daysSince(r.completed_at) !== null && daysSince(r.completed_at) >= 1 && daysSince(r.completed_at) <= 14);\n}).slice(0, 50);"
      },
      "id": "d71cd1a9-b63c-587e-827e-934d2a273b3b",
      "name": "Find rows to text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "from": "={{ $('Settings').first().json.config.twilio_from_number }}",
        "to": "={{ $json.phone }}",
        "message": "=Hi {{ $json.name }}, thanks for choosing {{ $('Settings').first().json.config.business_name }}! If you were happy, a quick review helps us a lot: {{ $('Settings').first().json.config.review_link }} Reply STOP to opt out.",
        "options": {}
      },
      "id": "64c5246e-b561-5454-a237-3b4e5435d085",
      "name": "Send the text",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        960,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const stamp = new Date().toISOString();\nreturn $('Find rows to text').all().map((item) => ({ json: { row_number: item.json.row_number, \"review_sms_sent\": stamp } }));"
      },
      "id": "e3cb1b16-d193-5681-9b16-b2adc3426be8",
      "name": "Mark rows as done",
      "type": "n8n-nodes-base.code",
