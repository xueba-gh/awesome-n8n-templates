          "__rl": true,
          "mode": "url",
          "value": "={{ $('Settings').first().json.config.sheet_url }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Settings').first().json.config.sheet_tab }}"
        },
        "options": {}
      },
      "id": "5665512a-3910-58e9-b137-52b948d8dd44",
      "name": "Read rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Settings').first().json.config;\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nreturn $input.all().filter((i) => has(i.json.image_url) && !has(i.json[\"alt_text\"])).slice(0, Number(cfg.rows_per_run));"
      },
      "id": "caa96dbe-fae6-5890-8852-85be42c44d08",
      "name": "Find rows to fill in",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write alt text (max 125 characters) for an image. Image file/URL: {{ $json.image_url }}. Context: {{ $json.context }}. Describe what is likely shown, no 'image of', do not invent details.",
        "hasOutputParser": true
      },
      "id": "c40fab06-7169-5f63-858f-46b4096d665d",
      "name": "AI: fill in the row",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "responsesApiEnabled": false,
        "options": {}
      },
      "id": "53df26cf-2d3b-53c5-bea8-5788a0a06efb",
      "name": "AI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        960,
        220
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"alt_text\": \"Short description\"\n}"
      },
      "id": "3ed064c5-de9b-5e95-b398-3d553ef58880",
      "name": "AI output format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1160,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => ({ json: { row_number: $('Find rows to fill in').all()[i].json.row_number, ...item.json.output } }));"
      },
      "id": "7eb84802-55f9-580e-bab4-2f3c02c9e60d",
      "name": "Match results to rows",
      "type": "n8n-nodes-base.code",
