{
  "name": "Proposal follow-up chaser (sends a nudge after 3 and 7 days)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
