          "__rl": true,
          "mode": "url",
          "value": "={{ $('Settings').first().json.config.sheet_url }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Settings').first().json.config.sheet_tab }}"
        },
        "options": {}
      },
      "id": "06f65210-6424-5dac-8b01-3f0c201e7c26",
      "name": "Read rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Settings').first().json.config;\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nreturn $input.all().filter((i) => has(i.json.message) && !has(i.json[\"language\"])).slice(0, Number(cfg.rows_per_run));"
      },
      "id": "ba5f468a-7611-5441-9a24-3f924ba5a41f",
      "name": "Find rows to fill in",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer message: {{ $json.message }}\nDetect the language, translate the message to English, and write a short, polite reply for {{ $('Settings').first().json.config.business_name }} in the customer's own language. Do not promise anything specific.",
        "hasOutputParser": true
      },
      "id": "45928c98-b659-5b4c-a0f9-5c3ec850e709",
      "name": "AI: fill in the row",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "responsesApiEnabled": false,
        "options": {}
      },
      "id": "80c6ccf5-6003-5c2c-b92a-1915d836a323",
      "name": "AI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        960,
        220
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"language\": \"Spanish\",\n  \"english\": \"Translation\",\n  \"reply_in_their_language\": \"Hola ...\"\n}"
      },
      "id": "916fcbc8-dd9a-5587-ad23-57d1948ed2c3",
      "name": "AI output format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1160,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => ({ json: { row_number: $('Find rows to fill in').all()[i].json.row_number, ...item.json.output } }));"
      },
      "id": "26227b15-d71e-5fd8-96df-c113b9c17f87",
      "name": "Match results to rows",
