            "row_number"
          ],
          "schema": []
        },
        "options": {
          "cellFormat": "RAW",
          "handlingExtraData": "ignoreIt"
        }
      },
      "id": "a5f42737-f857-540c-a84a-d8fbeea13d78",
      "name": "Update rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
