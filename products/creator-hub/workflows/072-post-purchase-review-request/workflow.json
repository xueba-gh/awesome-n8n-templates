      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"config\": {\n    \"sheet_url\": \"https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit\",\n    \"sheet_tab\": \"Orders\",\n    \"owner_email\": \"you@example.com\",\n    \"business_name\": \"Your Business\",\n    \"sender_name\": \"Your Name\",\n    \"review_link\": \"https://example.com/review\"\n  }\n}",
        "includeOtherFields": true,
        "options": {}
      },
      "id": "5489a99f-111a-5112-81c9-635df68e3987",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Settings').first().json.config.sheet_url }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Settings').first().json.config.sheet_tab }}"
        },
        "options": {}
      },
      "id": "037ebb2f-2118-565a-825e-34259e9df8a6",
      "name": "Read rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const daysSince = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (Date.now() - t) / 86400000; };\nconst daysUntil = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (t - Date.now()) / 86400000; };\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nconst cfg = $('Settings').first().json.config;\nreturn $input.all().filter((item) => {\n  const r = item.json;\n  return (!has(r.review_asked) && daysSince(r.delivered_date) !== null && daysSince(r.delivered_date) >= 10 && daysSince(r.delivered_date) < 40);\n}).slice(0, 50);"
      },
      "id": "6b1c1b68-cb81-5813-91b0-f16c1d6eedf0",
      "name": "Find rows to act on",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=How is your order {{ $json.order_number }}?",
        "emailType": "text",
        "message": "=Hi {{ $json.customer }},\n\nYour order should have arrived by now. If you have a minute, a review helps other shoppers:\n\n{{ $('Settings').first().json.config.review_link }}\n\nThank you,\n{{ $('Settings').first().json.config.business_name }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "0ee958b8-8e00-5b5a-8b23-403f7dd099f6",
      "name": "Send email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const stamp = new Date().toISOString().slice(0, 10);\nreturn $('Find rows to act on').all().map((item) => ({ json: { row_number: item.json.row_number, \"review_asked\": stamp } }));"
      },
      "id": "af032d17-33ff-5c89-baf5-f79b61fa4ac3",
      "name": "Mark rows as done",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
