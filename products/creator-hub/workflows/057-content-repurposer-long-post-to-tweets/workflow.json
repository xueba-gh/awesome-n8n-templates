    {
      "parameters": {
        "jsCode": "const cfg = $('Settings').first().json.config;\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nreturn $input.all().filter((i) => has(i.json.long_text) && !has(i.json[\"linkedin_post\"])).slice(0, Number(cfg.rows_per_run));"
      },
      "id": "8784610e-8150-5f32-9003-b565f752ebc9",
      "name": "Find rows to fill in",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Repurpose this content titled {{ $json.title }}:\n{{ $json.long_text }}\n\nWrite a LinkedIn post (max 120 words), a 5-point thread outline, and a two-sentence email teaser. Use only ideas that are in the text.",
        "hasOutputParser": true
      },
      "id": "b73a0e19-89bf-5ce6-85c4-b7e275a53134",
      "name": "AI: fill in the row",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
