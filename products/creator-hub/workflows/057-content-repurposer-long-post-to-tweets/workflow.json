        "responsesApiEnabled": false,
        "options": {}
      },
      "id": "d525055e-ecc0-5bea-8545-8679099d3e6b",
      "name": "AI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        960,
        220
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"linkedin_post\": \"Post\",\n  \"thread_outline\": \"1. ... 2. ...\",\n  \"email_teaser\": \"Teaser\"\n}"
      },
      "id": "b4849715-3a06-583d-8c12-1b30dc56efa3",
      "name": "AI output format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1160,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => ({ json: { row_number: $('Find rows to fill in').all()[i].json.row_number, ...item.json.output } }));"
      },
