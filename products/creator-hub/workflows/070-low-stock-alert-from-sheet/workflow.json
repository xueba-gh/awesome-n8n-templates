          "value": "={{ $('Settings').first().json.config.sheet_url }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Settings').first().json.config.sheet_tab }}"
        },
        "options": {}
      },
      "id": "2b414dea-a2b1-5dc2-bd65-a4688863398a",
      "name": "Read rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const daysSince = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (Date.now() - t) / 86400000; };\nconst daysUntil = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (t - Date.now()) / 86400000; };\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nconst cfg = $('Settings').first().json.config;\nreturn $input.all().filter((item) => {\n  const r = item.json;\n  return (Number(r.stock) <= Number(r.reorder_level) && !has(r.alerted));\n}).slice(0, 50);"
      },
      "id": "539bfe21-6327-542f-86c7-afeba7433919",
      "name": "Find rows to act on",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Settings').first().json.config.owner_email }}",
        "subject": "=Low stock: {{ $json.product }}",
        "emailType": "text",
        "message": "={{ $json.product }} (SKU {{ $json.sku }}) has {{ $json.stock }} left, below the reorder level of {{ $json.reorder_level }}. Supplier: {{ $json.supplier_email }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "db37a23d-9e96-5f73-8884-058c540805a7",
      "name": "Send email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const stamp = new Date().toISOString().slice(0, 10);\nreturn $('Find rows to act on').all().map((item) => ({ json: { row_number: item.json.row_number, \"alerted\": stamp } }));"
      },
      "id": "4ab405f0-8b17-5d82-bdd9-f567a8e006cd",
      "name": "Mark rows as done",
      "type": "n8n-nodes-base.code",
