      "id": "75a6a2f8-e1ab-5863-971d-e0d64d24c297",
      "name": "Read rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const daysSince = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (Date.now() - t) / 86400000; };\nconst daysUntil = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (t - Date.now()) / 86400000; };\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nconst cfg = $('Settings').first().json.config;\nreturn $input.all().filter((item) => {\n  const r = item.json;\n  return (String(r.status).toLowerCase() !== 'done' && !has(r.reminded) && daysUntil(r.due_date) !== null && daysUntil(r.due_date) >= 0 && daysUntil(r.due_date) <= 1.5);\n}).slice(0, 50);"
      },
      "id": "04dd0c1d-1b6e-57a9-9e11-4f4633875810",
      "name": "Find rows to act on",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.writer_email }}",
        "subject": "=Due soon: {{ $json.title }}",
        "emailType": "text",
        "message": "='{{ $json.title }}' is due on {{ $json.due_date }}. Please update the status when it is done.",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "969ab05c-db12-5d04-858c-c17e7d1ba6aa",
      "name": "Send email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const stamp = 'yes';\nreturn $('Find rows to act on').all().map((item) => ({ json: { row_number: item.json.row_number, \"reminded\": stamp } }));"
      },
      "id": "075315d9-5c1b-52d5-9c7f-54fe3a92a084",
      "name": "Mark rows as done",
