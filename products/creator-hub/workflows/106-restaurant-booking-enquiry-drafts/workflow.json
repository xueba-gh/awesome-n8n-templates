    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"is_booking\": true,\n  \"date\": \"Saturday\",\n  \"time\": \"19:30\",\n  \"party_size\": \"4\",\n  \"needs_reply\": true,\n  \"summary\": \"Table for 4 on Saturday evening.\",\n  \"reply_draft\": \"Hi ...\"\n}"
      },
      "id": "8314f552-c4d6-52f6-9e65-cb4270c6232c",
      "name": "AI output format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        920,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => ({ json: { ...$('Read the email').all()[i].json, ...item.json.output } }));"
      },
