        "jsonOutput": "{\n  \"config\": {\n    \"sheet_url\": \"https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit\",\n    \"sheet_tab\": \"Booking enquiries\",\n    \"owner_email\": \"you@example.com\",\n    \"business_name\": \"Your Business\",\n    \"sender_name\": \"Your Name\"\n  }\n}",
        "includeOtherFields": true,
        "options": {}
      },
      "id": "5a091282-65f0-54ed-98d8-d9e873962b5f",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((i) => {\n  const j = i.json;\n  const from = (j.from && j.from.value && j.from.value[0]) ? j.from.value[0] : {};\n  return { json: {\n    message_id: j.id, thread_id: j.threadId,\n    from_address: from.address || String(j.from || ''), from_name: from.name || '',\n    subject: j.subject || '', body: String(j.text || j.snippet || '').slice(0, 4000),\n    received_at: new Date().toISOString(),\n  } };\n});"
      },
      "id": "23f8ff0d-78a5-5d99-b05c-fea2e979210d",
      "name": "Read the email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You help a restaurant, {{ $('Settings').first().json.config.business_name }}. Decide if this email asks for a table booking. Extract date, time and party_size (or 'unknown'). Write a short friendly reply draft that thanks them and says you will confirm shortly. Do not confirm availability.\n\nEmail:\nFrom: {{ $json.from_name }} <{{ $json.from_address }}>\nSubject: {{ $json.subject }}\n\n{{ $json.body }}",
        "hasOutputParser": true
      },
      "id": "8f328f6d-c293-5eda-917d-32d6fe75b3bf",
      "name": "AI: read the email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
