{
  "name": "Quote follow-up for tradespeople (plumbers, electricians, builders)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "3894f540-42fc-5614-b639-e0a3e20b81f0",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"config\": {\n    \"sheet_url\": \"https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit\",\n    \"sheet_tab\": \"Quotes\",\n    \"owner_email\": \"you@example.com\",\n    \"business_name\": \"Your Business\",\n    \"sender_name\": \"Your Name\"\n  }\n}",
        "includeOtherFields": true,
        "options": {}
      },
      "id": "db46e907-6da5-59db-9138-0f4a2e81309d",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Settings').first().json.config.sheet_url }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Settings').first().json.config.sheet_tab }}"
        },
        "options": {}
      },
      "id": "4c31c8b2-18a7-5445-8b07-52e3b12dec8b",
      "name": "Read rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const daysSince = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (Date.now() - t) / 86400000; };\nconst daysUntil = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (t - Date.now()) / 86400000; };\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nconst cfg = $('Settings').first().json.config;\nreturn $input.all().filter((item) => {\n  const r = item.json;\n  return (String(r.status).toLowerCase() === 'sent' && daysSince(r.sent_date) !== null && daysSince(r.sent_date) >= 3 && (!has(r.last_follow_up) || daysSince(r.last_follow_up) >= 5));\n}).slice(0, 50);"
      },
      "id": "d1e17a43-dca9-56c2-a598-0e55655e75fe",
      "name": "Find rows to act on",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Your quote for {{ $json.job }}",
        "emailType": "text",
        "message": "=Hi {{ $json.customer }},\n\nI wanted to check you received my quote of {{ $json.quote_amount }} for {{ $json.job }}. Happy to answer questions or adjust the scope. I have a few slots free this month.\n\n{{ $('Settings').first().json.config.sender_name }}\n{{ $('Settings').first().json.config.business_name }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "9dc6b531-ce27-55ef-999b-94296d491a8f",
      "name": "Send email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const stamp = new Date().toISOString().slice(0, 10);\nreturn $('Find rows to act on').all().map((item) => ({ json: { row_number: item.json.row_number, \"last_follow_up\": stamp } }));"
      },
      "id": "fd8ecd87-ab87-58a8-8423-2149d47b988e",
      "name": "Mark rows as done",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "url",
