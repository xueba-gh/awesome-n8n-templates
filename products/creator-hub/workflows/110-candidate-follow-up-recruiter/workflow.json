    {
      "parameters": {
        "jsCode": "const daysSince = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (Date.now() - t) / 86400000; };\nconst daysUntil = (v) => { const t = Date.parse(v); return isNaN(t) ? null : (t - Date.now()) / 86400000; };\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nconst cfg = $('Settings').first().json.config;\nreturn $input.all().filter((item) => {\n  const r = item.json;\n  return (String(r.stage).toLowerCase() !== 'rejected' && String(r.stage).toLowerCase() !== 'hired' && daysSince(r.last_contact) !== null && daysSince(r.last_contact) >= 7);\n}).slice(0, 50);"
      },
      "id": "5d0388f3-4be9-5415-b4d8-f3add4360193",
      "name": "Find rows to act on",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
