        720,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Update on your application for {{ $json.role }}",
        "emailType": "text",
        "message": "=Hi {{ $json.candidate }},\n\nA quick update: your application for {{ $json.role }} is still active (stage: {{ $json.stage }}). I will message you as soon as there is news.\n\n{{ $('Settings').first().json.config.sender_name }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "13c7bc55-0f7f-5a81-b9e4-60468bde16f1",
      "name": "Send email",
