    {
      "parameters": {
        "promptType": "define",
        "text": "=Triage this GitHub issue. Suggest a label (bug, feature, question, docs), priority (low, normal, high) and a one-sentence summary.\n\nDetails received:\n- Title: {{ $json.title || 'not given' }}\n- Body: {{ $json.body || 'not given' }}\n- Html url: {{ $json.html_url || 'not given' }}\n- User login: {{ $json.user_login || 'not given' }}",
        "hasOutputParser": true
      },
