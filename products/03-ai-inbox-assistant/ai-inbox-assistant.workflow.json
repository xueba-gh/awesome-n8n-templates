    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"category\": \"sales_lead\",\n  \"urgency\": \"high\",\n  \"needs_reply\": true,\n  \"summary\": \"Wants a quote for a new water heater this week.\",\n  \"reply_draft\": \"Hi Bob,\\n\\nThanks for getting in touch...\"\n}"
      },
      "id": "057d0e92-57ff-5b86-bdf6-a0c3ad7789ce",
      "name": "Triage format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1000,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const email = $('One email at a time').first().json;\nconst ai = $json.output || {};\nconst allowed = ['sales_lead', 'customer_support', 'billing', 'scheduling', 'personal', 'newsletter', 'notification', 'spam', 'other'];\nconst category = allowed.includes(ai.category) ? ai.category : 'other';\nconst pretty = { sales_lead: 'Sales lead', customer_support: 'Customer support', billing: 'Billing', scheduling: 'Scheduling',\n  personal: 'Personal', newsletter: 'Newsletter', notification: 'Notification', spam: 'Spam', other: 'Other' }[category];\nconst needsReply = Boolean(ai.needs_reply) && !email.is_no_reply && String(ai.reply_draft || '').trim() !== '';\nconst subject = /^re:/i.test(email.subject) ? email.subject : 'Re: ' + email.subject;\nreturn [{ json: {\n  ...email,\n  category,\n  label_name: $('Settings').first().json.config.label_prefix + pretty,\n  urgency: ['high', 'medium', 'low'].includes(ai.urgency) ? ai.urgency : 'medium',\n  needs_reply: needsReply,\n  summary: ai.summary || '',\n  reply_subject: subject,\n  reply_draft: needsReply ? ai.reply_draft : '',\n  alert: category === 'sales_lead' || ai.urgency === 'high',\n}}];"
      },
