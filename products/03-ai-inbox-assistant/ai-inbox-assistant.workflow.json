      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"config\": {\n    \"your_name\": \"Sam Taylor\",\n    \"your_role_and_business\": \"owner of Acme Plumbing, a local plumbing company\",\n    \"facts_for_replies\": \"Opening hours Mon-Fri 8am-6pm. Free quotes. Booking link: https://cal.com/your-business. Emergency line: (555) 010-0000.\",\n    \"tone\": \"friendly, direct and professional\",\n    \"signature\": \"Best,\\nSam\\nAcme Plumbing | (555) 010-0000\",\n\n    \"alert_email\": \"you@example.com\",\n    \"label_prefix\": \"AI/\",\n\n    \"log_sheet_url\": \"https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit\",\n    \"log_tab\": \"Inbox log\"\n  }\n}",
        "includeOtherFields": true,
        "options": {}
      },
      "id": "2b380987-831c-5b68-a2d0-0da34db04b29",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Pulls out the parts of each email the AI needs, and skips mail it should never touch.\nconst out = [];\nfor (const { json: m } of $input.all()) {\n  const fromObj = m.from?.value?.[0] || {};\n  const fromRaw = typeof m.from === 'string' ? m.from : (m.from?.text || m.From || '');\n  const fromAddress = (fromObj.address || (fromRaw.match(/<([^>]+)>/) || [, fromRaw])[1] || '').trim().toLowerCase();\n  const fromName = fromObj.name || fromRaw.replace(/<[^>]+>/, '').replace(/\"/g, '').trim();\n  const subject = String(m.subject || m.Subject || '(no subject)').trim();\n  if (subject.startsWith('[Inbox Assistant]')) continue; // our own alerts\n  let body = String(m.text || m.snippet || '').replace(/\\r/g, '');\n  body = body.split(/\\n(?:On .{5,200}wrote:|-----Original Message-----|From: .+\\nSent: )/)[0]; // drop quoted history\n  out.push({ json: {\n    message_id: m.id,\n    thread_id: m.threadId,\n    from_address: fromAddress,\n    from_name: fromName,\n    subject,\n    body: body.trim().slice(0, 6000),\n    is_no_reply: /(no-?reply|do-?not-?reply|mailer-daemon|notifications?@|bounce)/i.test(fromAddress),\n  }});\n}\nreturn out;"
      },
      "id": "188381e6-5d49-549f-9329-89405f8d33b7",
      "name": "Prepare email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "5b8d7ea4-3734-51bc-9e80-df0f9f65a447",
      "name": "One email at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are the email assistant of {{ $('Settings').first().json.config.your_name }}, {{ $('Settings').first().json.config.your_role_and_business }}.\nFacts you may use in replies: {{ $('Settings').first().json.config.facts_for_replies }}\n\nRead this email and triage it.\n\nFrom: {{ $json.from_name }} <{{ $json.from_address }}>\nSubject: {{ $json.subject }}\nAutomated sender: {{ $json.is_no_reply ? 'yes' : 'no' }}\n\n{{ $json.body }}\n\nReturn:\n- category: exactly one of sales_lead (a potential new customer or a request for a quote/price), customer_support (an existing customer needs help), billing (invoices, payments, refunds), scheduling (meetings, appointments), personal, newsletter (marketing, newsletters, promotions), notification (automated alerts, receipts, system messages), spam, other.\n- urgency: high (needs action today, an angry customer, money or a deadline at stake), medium, or low.\n- needs_reply: true only if a real person is waiting for an answer from us. Always false for newsletter, notification, spam and automated senders.\n- summary: one sentence saying what the sender wants.\n- reply_draft: if needs_reply is true, a reply in the sender's language. Tone: {{ $('Settings').first().json.config.tone }}. Answer what you can from the facts above; where you need information you don't have, write [CHECK: what to check] so the owner can fill it in. Do not promise prices, dates or refunds that aren't in the facts. End with this signature exactly:\n{{ $('Settings').first().json.config.signature }}\n  If needs_reply is false, return an empty string.",
        "hasOutputParser": true
      },
      "id": "e445aef4-9f2c-5a72-8dd8-74ac359797f9",
      "name": "AI: triage email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        900,
        100
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "responsesApiEnabled": false,
        "options": {}
      },
      "id": "fa75ea65-92ca-535d-ae1b-d8c467e485cb",
      "name": "OpenAI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        860,
        320
